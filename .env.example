APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
FRONTEND_DIR=./web/dist
LOG_LEVEL=INFO

# Start with the deterministic fake provider. Switch to nvidia or openai for live runs.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
OPENAI_REASONING_EFFORT=low
OPENAI_INPUT_COST_PER_MILLION=8.00
OPENAI_CACHED_INPUT_COST_PER_MILLION=0.40
OPENAI_OUTPUT_COST_PER_MILLION=40.00

# NVIDIA's hosted NIM endpoint is free for development/testing, subject to its terms and limits.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_INPUT_COST_PER_MILLION=0.00
NVIDIA_CACHED_INPUT_COST_PER_MILLION=0.00
NVIDIA_OUTPUT_COST_PER_MILLION=0.00

# Optional. When empty in local mode, a random key is generated under ignored data/.
APPROVAL_HMAC_KEY=

# Guardrail and workflow limits
MAX_UPLOAD_BYTES=10485760
MAX_DATASET_ROWS=100000
MAX_RETRIEVAL_ROUNDS=3
MAX_PLAN_REVISIONS=2
MAX_PATCH_OPERATIONS=5
LANGGRAPH_STRICT_MSGPACK=true

