{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-incident-investigator.local/schemas/trace-event-1.0.json",
  "title": "Data Incident Investigator Trace Event",
  "description": "One JSONL event emitted by an evaluation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "fixture_id",
    "sequence",
    "timestamp",
    "event_type",
    "phase",
    "actor",
    "status",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "pattern": "^I(0[1-9]|1[0-9]|20)$"},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_type": {
      "type": "string",
      "enum": [
        "run_started",
        "artifact_ingested",
        "plan_created",
        "plan_revised",
        "retrieval_query",
        "retrieval_completed",
        "tool_requested",
        "tool_completed",
        "hypothesis_verified",
        "hypothesis_invalidated",
        "patch_proposed",
        "approval_requested",
        "approval_resolved",
        "patch_applied",
        "validation_completed",
        "security_event",
        "usage_recorded",
        "run_completed",
        "run_failed"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["ingest", "retrieve", "plan", "diagnose", "verify", "approve", "repair", "evaluate", "complete"]
    },
    "actor": {"type": "string", "minLength": 1},
    "span_id": {"type": ["string", "null"]},
    "parent_span_id": {"type": ["string", "null"]},
    "prompt_version": {"type": ["string", "null"]},
    "model_provider": {"type": ["string", "null"]},
    "model_name": {"type": ["string", "null"]},
    "model_parameters": {"type": "object"},
    "input_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
    },
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "status": {"type": "string", "enum": ["started", "completed", "blocked", "failed", "skipped"]},
    "error_code": {"type": ["string", "null"]},
    "security_labels": {
      "type": "array",
      "items": {"type": "string", "enum": ["untrusted_input", "contains_canary", "policy_blocked", "redacted"]},
      "uniqueItems": true
    },
    "usage": {"$ref": "#/$defs/usage"},
    "payload": {"type": "object"}
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cached_tokens", "estimated_cost_usd"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
